# ─── Stage 1: Build Go binary ────────────────────────────
FROM golang:1.25-alpine AS builder
RUN apk add --no-cache git ca-certificates

WORKDIR /app

# Install Go deps first (layer cache)
COPY go.mod go.sum ./
RUN go mod download

# Copy source (web/ excluded via .dockerignore for agent)
COPY . .

# Build static binary
ARG VERSION=dev
ARG COMMIT=unknown
RUN CGO_ENABLED=0 GOOS=linux go build \
    -trimpath \
    -ldflags "-s -w -X main.Version=${VERSION} -X main.Commit=${COMMIT}" \
    -o /out/dockeeper-agent \
    ./cmd/agent

# ─── Stage 2: Minimal runtime ────────────────────────────
FROM alpine:3.21
RUN apk add --no-cache ca-certificates tzdata \
    && addgroup -S dockeeper \
    && adduser -S -G dockeeper dockeeper

COPY --from=builder /out/dockeeper-agent /usr/local/bin/dockeeper-agent

USER dockeeper
WORKDIR /home/dockeeper

ENTRYPOINT ["dockeeper-agent"]
